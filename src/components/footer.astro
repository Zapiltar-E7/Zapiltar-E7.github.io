---
import { site, socialHref, socialSvg } from "../data/site";

const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
      <div class="flex flex-col lg:items-start items-center space-y-6 gap-9">
        <div class="flex flex-wrap justify-center gap-6 sm:gap-8">
          {
            site.socials.map((link) => (
              <a
                href={socialHref(link)}
                target={link.icon === "email" ? undefined : "_blank"}
                rel="noopener"
                title={link.label}
                class="flex flex-col items-center group"
                aria-label={link.label}
              >
                <div class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out">
                  <div set:html={socialSvg(link.icon)} />
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col items-center space-y-6">
        <div class="grid grid-cols-1 gap-3 w-full max-w-xs py-6">
          {
            [
              {
                desc: "Built with",
                name: "Astro",
                icon: `${baseUrl}svg/astro.svg`,
                alt: "Astro Logo",
              },
              {
                desc: "Styled with",
                name: "TailwindCSS",
                icon: `${baseUrl}svg/tailwindcss.svg`,
                alt: "TailwindCSS Logo",
              },
              {
                desc: "Deployed on",
                name: "GitHub Pages",
                icon: `${baseUrl}svg/git.svg`,
                alt: "Git Logo",
              },
            ].map((tech) => (
              <div class="flex items-center justify-center lg:justify-normal space-x-3">
                <span class="text-[var(--white-icon)] text-sm">
                  {tech.desc}
                </span>
                <img
                  src={tech.icon}
                  alt={tech.alt}
                  class="h-5 w-5 object-contain filter brightness-0 invert opacity-50"
                  loading="lazy"
                />
                <span class="text-[var(--white-icon)] text-sm">
                  {tech.name}
                </span>
              </div>
            ))
          }
        </div>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-[#ffffff10]">
      <p class="text-center text-sm text-[var(--white-icon)] space-y-2">
        <!-- If you are using this template, by MIT License you can't remove the copyright notice -->
        <span class="block sm:inline"
          >Copyright © {currentYear} {site.name}. All rights reserved by <a target="_blank" class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out" href="https://github.com/Gothsec" target="_blank">Andres Hernandez</a> <br> Distributed by <a target="_blank" class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out" href="https://themewagon.com" target="_blank">ThemeWagon</a></span
        >
      </p>
    </div>
  </div>
</footer>
