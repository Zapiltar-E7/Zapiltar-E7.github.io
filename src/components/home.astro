---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LightPillar from "../React/LightPillar.jsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import { site, socialHref, socialSvg, skillSvg, highlightParts } from "../data/site";

const headline = site.hero.headline.split("\n");
const skills = site.skills.items.map((s) => ({ ...s, svg: skillSvg(s.icon) }));
---

<section class="text-[var(--white)] mt-12 md:mt-0 relative" id="home">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[520px] md:h-[680px] z-0" aria-hidden="true">
    <LightPillar
      client:load
      topColor="#A476FF"
      bottomColor="#5e4491"
      intensity={0.9}
      glowAmount={0.002}
      bloom={0.5}
      pillarWidth={3}
      pillarHeight={0.4}
      pillarRotation={25}
      rotationSpeed={0.3}
      fade={0.6}
      quality="medium"
      mixBlendMode="screen"
    />
  </div>
  <div class="relative z-10 max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-left space-y-4">
      <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
        {site.hero.greeting}
      </p>
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none"
        >
          {headline.map((line, i) => <>{i > 0 && <br />}{line}</>)}
        </h1>
        <p class="text-md md:text-2xl text-[var(--white-icon)]">
          {highlightParts(site.hero.intro).map((part) =>
            part.hl ? <span class="text-[var(--sec)] shiny-sec">{part.text}</span> : part.text
          )}
        </p>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        {
          site.socials.map((link) => (
            <a
              target={link.icon === "email" ? undefined : "_blank"}
              rel="noopener"
              href={socialHref(link)}
              aria-label={link.label}
              title={link.label}
              class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
              set:html={socialSvg(link.icon)}
            />
          ))
        }
      </div>
    </div>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load title={site.skills.title} skills={skills} />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
